# Netlify Functions / Netlify Blobs
# Set this in Netlify → Project configuration → Environment variables.
ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional: defaults shown below
BLOBS_REGION=ap-southeast-1
BLOBS_STORE_NAME=anime-soul-responses

# Optional HTTPS JSON endpoint for an authorized Bangumi comment feed.
# BANGUMI_COMMENT_FEED=https://your-authorized-provider.example/comments
